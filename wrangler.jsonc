{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "haijie-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "haijieliu.com", "custom_domain": true },
    { "pattern": "www.haijieliu.com", "custom_domain": true }
  ],
  "vars": {
    "R2_CDN_URL": "https://media.haijieliu.com"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "haijie-media"
    }
  ]
}
